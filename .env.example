# --- GitHub ---
# Personal access token with repo:read, pull-requests:read, and (if using checks) workflow scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Comma-separated list of full repo names to track, e.g. "org/repo-a,org/repo-b"
GITHUB_REPOS=adityavram/pr-review-agent-demo

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pr_review_agent

# --- Ollama (cloud-hosted, OpenAI-compatible) ---
OLLAMA_BASE_URL=https://api.olama.cloud/v1
OLLAMA_API_KEY=your-ollama-api-key-here
OLLAMA_MODEL=llama3.1

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-xxx
# Optional: restrict the agent to only DM these Slack user IDs (comma-separated) during v1
SLACK_ALLOWED_USER_IDS=

# --- Orchestrator ---
# How often the sync+act loop runs, in milliseconds. Default 15 min.
POLL_INTERVAL_MS=900000
# Dry-run mode: compute decisions but do NOT send Slack messages or mutate Git state
DRY_RUN=true
LOG_LEVEL=info

# --- Web UI ---
PORT=3000