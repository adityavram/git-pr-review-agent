{
  "name": "git-pr-review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agent that manages PR reviewer morale at scale by tracking repo/branch/reviewer state and orchestrating socially-acceptable follow-up cadence.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "tsx src/db/migrate.ts",
    "sync": "tsx src/commands/sync.ts",
    "once": "tsx src/commands/runOnce.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@slack/web-api": "^7.9.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.7",
    "kysely": "^0.27.4",
    "octokit": "^4.1.3",
    "openai": "^7.13.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
